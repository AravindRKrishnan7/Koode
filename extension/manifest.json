{
  "manifest_version": 3,
  "name": "Koode — കൂടെ",
  "version": "0.1.0",
  "description": "Screen-aware guide: points to the right control, waits for you to act, and verifies each step.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "src/background/service-worker.js" },
  "action": { "default_title": "Koode: guide me on this page" },
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*"],
      "js": [
        "src/shared/constants.js",
        "src/content/extractor.js",
        "src/content/overlay.js",
        "src/content/monitor.js",
        "src/content/voice.js",
        "src/content/panel.js",
        "src/content/controller.js",
        "src/content/main.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
