{
  "manifest_version": 3,
  "name": "Koode — കൂടെ",
  "version": "0.2.0",
  "description": "Screen-aware guide: points to the right control, waits for you to act, and verifies each step.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "sidePanel",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://docs.google.com/forms/*",
    "https://web.whatsapp.com/*",
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "action": {
    "default_title": "Koode — open the companion panel"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://docs.google.com/forms/*",
        "https://web.whatsapp.com/*",
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/shared/constants.js",
        "src/shared/sites.js",
        "src/content/extractor.js",
        "src/content/overlay.js",
        "src/content/monitor.js",
        "src/content/voice.js",
        "src/content/panel.js",
        "src/content/controller.js",
        "src/content/main.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  }
}
